# Riot dev key (expires every 24h). developer.riotgames.com
RIOT_API_KEY=
RIOT_PLATFORM=na1
RIOT_REGION=americas

# Gemini key. aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ranked queue id is unverified (expected 1100). Check with `python -m tftnet parse --any-queue`.
TFT_QUEUE_IDS=1100
TFT_SET=18
# 2026-08-26 00:00 PDT (Set 18 launch) as unix seconds
SET_START_EPOCH=1787727600
